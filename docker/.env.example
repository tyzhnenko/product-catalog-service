# Copy this file to docker/.env and replace every set_your_* value with a real one.
# docker/.env is git-ignored; never commit real credentials.

# Mongo root (used by mongo-express and to bootstrap the database)
MONGO_ROOT_USERNAME=set_your_mongo_root_username_here
MONGO_ROOT_PASSWORD=set_your_mongo_root_password_here

# Mongo user the app connects as (readWrite on product_catalog); must differ from root
MONGO_APP_USERNAME=set_your_mongo_app_username_here
MONGO_APP_PASSWORD=set_your_mongo_app_password_here

# mongo-express basic auth (http://localhost:8081)
ME_BASICAUTH_USERNAME=set_your_mongo_express_username_here
ME_BASICAUTH_PASSWORD=set_your_mongo_express_password_here

# API keys (must be different from each other)
APP_RW_X_API_KEY=set_your_rw_api_key_here
APP_RO_X_API_KEY=set_your_ro_api_key_here
